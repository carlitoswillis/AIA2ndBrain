# LLM for triage summaries: the Claude Code CLI (subscription login, no key)
# is primary; Gemini is the backstop. Pin with LLM_PROVIDER=gemini to flip.
# LLM_PROVIDER=claude
# CLAUDE_MODEL=sonnet

# Gemini API key (same key the watcher uses in the repo root .env) — the backstop
GEMINI_API_KEY=YOUR_KEY_HERE

# Bearer/query token guarding POST|GET /api/save (bookmarklet, iOS Shortcut).
# Generate one: openssl rand -hex 24
SAVE_TOKEN=CHANGE_ME

# Where "Keep" exports markdown for the AIA2ndBrain watcher to classify.
# Defaults to the iCloud SecondBrain inbox if unset.
# VAULT_INBOX=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/SecondBrain/Inbox/notes

# Where the SQLite file lives (defaults to ./data)
# DATA_DIR=./data
