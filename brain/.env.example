# LLM for triage summaries: the Claude Code CLI (subscription login, no key)
# is primary; Gemini is the backstop. Pin with LLM_PROVIDER=gemini to flip.
# LLM_PROVIDER=claude
# CLAUDE_MODEL=sonnet

# Gemini API key (same key the watcher uses in the repo root .env) — the backstop
GEMINI_API_KEY=YOUR_KEY_HERE

# Bearer/query token guarding POST|GET /api/save (bookmarklet, iOS Shortcut).
# Generate one: openssl rand -hex 24
SAVE_TOKEN=CHANGE_ME

# Where "Keep" exports markdown for the AIA2ndBrain watcher to classify.
# Defaults to the iCloud SecondBrain inbox if unset.
# VAULT_INBOX=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/SecondBrain/Inbox/notes

# Where the SQLite file lives (defaults to ./data)
# DATA_DIR=./data

# --- Library index (phase 2) ---
# Roots the indexer reads. Read-only: files on disk are the source of truth and
# the index is rebuildable from them at any time.
# VAULT_ROOT defaults to the iCloud SecondBrain folder.
# VAULT_ROOT=/Users/you/Library/Mobile Documents/com~apple~CloudDocs/SecondBrain
# NOTES_ROOT defaults to ../Notes (the Exporter.app output in this repo).
# NOTES_ROOT=../Notes

# Current-work context for triage: the sibling Working Memory app's SQLite DB,
# read read-only. Triage judges each save against your open items and flags a
# real tie. Optional — if this is missing, summaries are just generic.
# Defaults to ~/workspace/workingmemory/data/owner/wm.db
# WM_DB_PATH=/Users/you/workspace/workingmemory/data/owner/wm.db

# NOTE: that local file is a snapshot — the DEPLOYED Working Memory is the source
# of truth. Context older than this many hours is withheld rather than trusted.
# WM_STALE_HOURS=48

# Deployed Working Memory (preferred context source when set): lib/wm-remote.ts
# pulls a verified read-only snapshot of the hosted DB via GET /api/export and
# refreshes it in the background every WM_FETCH_TTL_MIN minutes. Values live in
# ~/.wm-backup.env (same ones the launchd backup pull uses). READ-ONLY — nothing
# is ever written back to Working Memory.
# WM_URL=https://workingmemory.onrender.com
# WM_OWNER_SECRET=...
# WM_FETCH_TTL_MIN=15
# The hosted DB is multi-tenant; context is scoped to the owner (first-created
# account). Set explicitly if that ever stops being you:
# WM_OWNER_USERNAME=...

# The scoped bridge (preferred over WM_OWNER_SECRET once WM is deployed with a
# matching BRAIN_TOKEN): GET /api/context for triage context (~2KB, owner-scoped
# by WM itself) and POST /api/items for the reader's "→ Board" push. Same value
# as BRAIN_TOKEN in the WM deployment's env.
# WM_BRAIN_TOKEN=...
