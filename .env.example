# Watcher config (src/main.js). The brain app has its own brain/.env.

# Classification provider order. Default "claude" runs the headless Claude Code
# CLI on your subscription login — no API key needed. Whichever is primary, the
# other backstops on failure, so configuring both is the resilient setup.
# LLM_PROVIDER=claude
# CLAUDE_MODEL=sonnet

# Gemini backstop (also the primary if LLM_PROVIDER=gemini).
# Note: gemini-2.5-pro is limit:0 on the free tier — leave this on flash.
GEMINI_API_KEY=YOUR_KEY_HERE
# GEMINI_MODEL=models/gemini-2.5-flash

# Idempotency ledger location (defaults to ./data/processed.json)
# LEDGER_PATH=./data/processed.json
